{
  "name": "precedent",
  "version": "0.0.0",
  "description": "Learn a team's unwritten code review rules from past pull requests.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "precedent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval:docs": "tsx scripts/eval-docs.ts",
    "eval:docs:e2e": "tsx scripts/eval-docs-e2e.ts",
    "eval:refresh": "tsx scripts/eval-refresh.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
