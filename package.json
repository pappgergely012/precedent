{
  "name": "precedent-review",
  "version": "0.1.0",
  "description": "Learn a team's unwritten code review rules from past pull requests.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "precedent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval:docs": "tsx scripts/eval-docs.ts",
    "eval:docs:e2e": "tsx scripts/eval-docs-e2e.ts",
    "eval:refresh": "tsx scripts/eval-refresh.ts",
    "check:pack": "node scripts/check-pack.mjs",
    "snapshots": "tsx scripts/save-snapshots.ts",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepublishOnly": "tsc -p tsconfig.build.json && node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://github.com/pappgergely012/precedent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pappgergely012/precedent.git"
  },
  "bugs": {
    "url": "https://github.com/pappgergely012/precedent/issues"
  },
  "keywords": [
    "code-review",
    "pull-requests",
    "conventions",
    "llm",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  }
}
